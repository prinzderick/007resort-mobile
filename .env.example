# otueke-mobile build configuration (placeholders only - never commit real values).
#
# Flutter reads these as compile-time --dart-define values, e.g.:
#   flutter run --dart-define-from-file=.env
# or individually:
#   flutter run --dart-define=OTUEKE_API_BASE_URL=http://10.0.2.2:5080 --dart-define=OTUEKE_ENV=dev
#
# NOTE: dart-define values are embedded in the APK. Do NOT put secrets here.

# Base URL of the Otueke API (no trailing /api/v1). Emulator default shown.
OTUEKE_API_BASE_URL=http://10.0.2.2:5080

# dev | staging | production
OTUEKE_ENV=dev
