# 007resort-mobile build configuration (placeholders only - never commit real values).
#
# Flutter reads these as compile-time --dart-define values, e.g.:
#   flutter run --dart-define-from-file=.env
# or individually:
#   flutter run --dart-define=R007_MOCK=true
#
# NOTE: dart-define values are embedded in the APK. Do NOT put secrets here.

# Run against the built-in Mock API (demo without a backend).
R007_MOCK=false

# Preset server address (no trailing /api/v1). Leave empty to type it on the tablet.
# R007_API_BASE_URL=http://192.168.1.10:8080

# dev | staging | production
R007_ENV=dev

# Idle auto-lock in seconds (attendant + supervisor tablets).
R007_IDLE_LOCK_SECS=300

# Fallbacks only when GET /api/v1/system/info does not publish `realtime`.
# R007_REVERB_KEY=
# R007_REVERB_PORT=8081
# R007_REVERB_SCHEME=ws
