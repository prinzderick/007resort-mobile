# 007resort-mobile build configuration (placeholders only - never commit real values).
#
# Flutter reads these as compile-time --dart-define values, e.g.:
#   flutter run --dart-define-from-file=.env
# or individually:
#   flutter run --dart-define=R007_API_BASE_URL=http://10.0.2.2:5080 --dart-define=R007_ENV=dev
#
# NOTE: dart-define values are embedded in the APK. Do NOT put secrets here.

# Base URL of the 007 Resort & Spa API (no trailing /api/v1). Emulator default shown.
R007_API_BASE_URL=http://10.0.2.2:5080

# dev | staging | production
R007_ENV=dev
